<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml" />

    <property name="REDACTION_PATTERN"
              value="(?i)(Bearer\s+)[A-Za-z0-9._~-]+|(password|senha|token|secret)(\s*[=:]\s*)[^\s,;]+|[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}" />
    <property name="REDACTION_REPLACEMENT" value="$1$2$3[REDACTED]" />

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN:-%d{yyyy-MM-dd'T'HH:mm:ss.SSS} %-5level %logger{36} - }%replace(%msg){'${REDACTION_PATTERN}','${REDACTION_REPLACEMENT}'}%replace(%ex){'${REDACTION_PATTERN}','${REDACTION_REPLACEMENT}'}%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>